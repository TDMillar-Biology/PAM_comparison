Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author "CRISPR-CFD Pipeline"
    Version "1.0"
    Stage "06_cfd_scores_07_summary_08_figures"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        procps \
        ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    mamba create -y -n python_analysis -c conda-forge -c bioconda \
        python=3.10 \
        numpy \
        pandas \
        scipy \
        matplotlib-base \
        seaborn \
        plotly \
        biopython \
        intervaltree
    mamba clean -a -y

%environment
    export PATH=/opt/conda/envs/python_analysis/bin:$PATH
    export CONDA_DEFAULT_ENV=python_analysis

%runscript
    exec "$@"
