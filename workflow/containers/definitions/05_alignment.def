Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author "CRISPR-CFD Pipeline"
    Version "1.0"
    Stage "05_alignment"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        procps \
        ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    mamba create -y -n alignment -c conda-forge -c bioconda \
        bowtie \
        bowtie2 \
        samtools
    mamba clean -a -y

%environment
    export PATH=/opt/conda/envs/alignment/bin:$PATH
    export CONDA_DEFAULT_ENV=alignment

%runscript
    exec "$@"
