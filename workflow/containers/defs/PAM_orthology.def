
Bootstrap: docker
From: condaforge/miniforge3:latest

%files
    /home/mahullocaladmin/Desktop/projects/svmu2_package /opt/svmu2_package

%post
    conda install -y \
        -c conda-forge \
        -c bioconda \
        python=3.11 \
        biopython \
        pandas \
        numpy \
        pysam \
        bedtools \
        intervaltree \
        matplotlib \
        matplotlib-venn \
        seaborn \
        mpld3 \
        plotly \
        pip

    python -m pip install --no-cache-dir /opt/svmu2_package

    conda clean -afy

%environment
    export PATH=/opt/conda/bin:$PATH
    export MPLBACKEND=Agg

%test
    python -c "import pandas, numpy, pysam, matplotlib, matplotlib_venn, seaborn, mpld3, intervaltree"
    python -c "from svmu2.orchestration.parse import parse"
    python -c "from svmu2.orchestration.synteny import resolve_synteny"
